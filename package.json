{
  "name": "pzzadocs",
  "version": "0.1.3",
  "description": "A customizable MDX docs framework for Next.js.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Berke (pzzaworks)",
    "url": "https://pzza.works"
  },
  "homepage": "https://docs.pzza.works",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pzzaworks/pzza-docs.git"
  },
  "bugs": {
    "url": "https://github.com/pzzaworks/pzza-docs/issues"
  },
  "keywords": [
    "nextjs",
    "mdx",
    "documentation",
    "docs",
    "react"
  ],
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./mdx": {
      "types": "./dist/mdx/index.d.ts",
      "import": "./dist/mdx/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./math.css": "./dist/math.css"
  },
  "scripts": {
    "build": "rm -rf dist && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "next": "^16",
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@shikijs/transformers": "4.5.0",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "hast-util-to-string": "3.0.1",
    "katex": "0.19.0",
    "lucide-react": "1.55.0",
    "mdast-util-to-string": "4.0.0",
    "mermaid": "12.1.0",
    "next-themes": "0.4.6",
    "rehype-katex": "7.0.1",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "server-only": "0.0.1",
    "shiki": "4.5.0",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/mdx": "2.0.14",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
